{
  "name": "pinte-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run guides:build && vite",
    "build": "npm run guides:verify && vite build",
    "build:seo": "npm run guides:verify && vite build && npx tsc --skipLibCheck -p tsconfig.prerender.json && mkdir -p ./tmp-prerender/scripts && cp ./scripts/seo-geo-sop.config.mjs ./tmp-prerender/scripts/seo-geo-sop.config.mjs && node ./tmp-prerender/prerender.js && rm -rf ./tmp-prerender",
    "prerender": "npm run guides:build && npx tsc --skipLibCheck -p tsconfig.prerender.json && mkdir -p ./tmp-prerender/scripts && cp ./scripts/seo-geo-sop.config.mjs ./tmp-prerender/scripts/seo-geo-sop.config.mjs && node ./tmp-prerender/prerender.js && rm -rf ./tmp-prerender",
    "preview": "vite preview",
    "sync-blog": "node scripts/fetch-blog.js",
    "generate-sitemap": "npm run guides:build && node --loader ts-node/esm scripts/generate-sitemap.js",
    "guides:build": "node scripts/build-guide-content.mjs",
    "guides:topics": "node scripts/generate-guide-topics.mjs",
    "guides:topics:test": "node --test scripts/guide-topics.test.mjs",
    "guides:validate": "node scripts/validate-guide-content.mjs",
    "guides:test": "node --test scripts/guide-content.test.mjs scripts/seo-source-check.test.mjs",
    "guides:verify": "node scripts/build-guide-content.mjs --check && node scripts/seo-source-check.mjs",
    "guides:check": "npm run guides:test && npm run guides:verify",
    "seo:sop": "node scripts/seo-geo-sop.mjs",
    "seo:sop:test": "node scripts/seo-geo-sop.test.mjs",
    "indexnow": "ts-node scripts/submit-sitemap-indexnow.ts"
  },
  "dependencies": {
    "@emailjs/browser": "3.11.0",
    "@google/generative-ai": "^0.21.0",
    "@notionhq/client": "^2.2.14",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@remix-run/router": "1.15.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.559.0",
    "marked": "^18.0.6",
    "notion-to-md": "^3.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "6.22.3",
    "react-router-dom": "6.22.3",
    "sanitize-html": "^2.17.6",
    "three": "^0.182.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
