# Root path is already fine
/ /index.html 200

# Add trailing slash for language root (e.g. /cn -> /cn/)
/:lang /:lang/ 301

# Add trailing slash for language subpaths without extension
# Cloudflare automatically skips existing physical files
/:lang/* /:lang/*/ 301

# Skip index.html files to avoid infinite loop - serve directly
/:lang/*/index.html /:lang/*/index.html 200

# Rewrite directory with trailing slash to the corresponding index.html
/:lang/*/ /:lang/*/index.html 200
