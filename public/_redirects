# Cloudflare Pages routing - SEO + SPA support

# Static files pass through
/*.html  /*.html 200
/*.css   /*.css   200
/*.js    /*.js    200
/*.png   /*.png  200
/*.jpg   /*.jpg  200
/*.jpeg  /*.jpeg 200
/*.webp  /*.webp 200
/*.svg   /*.svg  200
/*.ico   /*.ico  200
/*.txt   /*.txt  200
/*.xml   /*.xml  200
/*.json  /*.json 200

# Deep paths that need SPA routing - return index.html
/cn/products/*  /index.html 200
/en/products/*  /index.html 200
/cn/solutions/*  /index.html 200
/en/solutions/*  /index.html 200
/cn/blog/*  /index.html 200
/en/blog/*  /index.html 200

# 301 redirects for root paths
/about  /cn/about 301
/products  /cn/products 301
/culture  /cn/culture 301
/quote  /cn/quote 301
/tour  /cn/tour 301
/blog  /cn/blog 301
/privacy  /cn/privacy 301
/terms  /cn/terms 301
/solutions/:splat  /cn/solutions/:splat 301
/products/:splat  /cn/products/:splat 301
/blog/:splat  /cn/blog/:splat 301
/  /cn/ 301