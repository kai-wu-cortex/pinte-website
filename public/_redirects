# Cloudflare routing
# Order matters - most specific first

# Let all files with extensions pass through directly
/*.html  /*.html  200
/*.css   /*.css   200
/*.js    /*.js    200
/*.png   /*.png  200
/*.jpg   /*.jpg  200
/*.jpeg  /*.jpeg 200
/*.webp  /*.webp 200
/*.svg   /*.svg  200
/*.ico   /*.ico  200
/*.txt   /*.txt  200
/*.xml   /*.xml  200
/*.json  /*.json 200

# All other paths return index.html for React Router
/cn/*  /index.html  200
/en/*  /index.html  200