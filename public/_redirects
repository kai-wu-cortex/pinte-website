# === SPA 路由配置 + SEO 权重传递 ===

# 1. 让所有带扩展名的文件直接通过
# 包括预渲染的 .html 文件（如 /cn/products/foils/index.html）
*.html  200
*.css   200
*.js    200
*.png   200
*.jpg   200
*.jpeg  200
*.webp  200
*.svg   200
*.ico   200
*.txt   200
*.xml   200
*.json  200

# 2. 根路径重定向到中文版（301 永久重定向，权重传递）
/about  /cn/about 301
/solutions/:splat  /cn/solutions/:splat 301
/products  /cn/products 301
/culture  /cn/culture 301
/quote  /cn/quote 301
/tour  /cn/tour 301
/blog  /cn/blog 301
/privacy  /cn/privacy 301
/terms  /cn/terms 301
/  /cn/ 301

# 3. 语言前缀的深层路径返回 index.html（重写，地址栏不变）
# 让 React Router 处理 SPA 路由
# 优先使用预渲染的 HTML 文件（规则1），否则返回 index.html
# 3. 语言前缀的深层路径返回 index.html（重写，地址栏不变）
# 排除根路径 /cn/ 和 /cn/index.html，避免无限循环
/cn/about/*  /index.html 200
/cn/solutions/*  /index.html 200
/cn/products/*  /index.html 200
/cn/culture/*  /index.html 200
/cn/quote/*  /index.html 200
/cn/tour/*  /index.html 200
/cn/blog/*  /index.html 200
/cn/privacy/*  /index.html 200
/cn/terms/*  /index.html 200
/en/about/*  /index.html 200
/en/solutions/*  /index.html 200
/en/products/*  /index.html 200
/en/culture/*  /index.html 200
/en/quote/*  /index.html 200
/en/tour/*  /index.html 200
/en/blog/*  /index.html 200
/en/privacy/*  /index.html 200
/en/terms/*  /index.html 200