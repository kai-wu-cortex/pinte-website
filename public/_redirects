# SPA routing for Cloudflare Pages
# Workaround for Wrangler bug #11824 - false positive infinite loop detection
# Exclude all static file extensions first to avoid matching existing files
/*.html  :splat  200
/*.js    :splat  200
/*.css   :splat  200
/*.png   :splat  200
/*.jpg   :splat  200
/*.jpeg  :splat  200
/*.svg   :splat  200
/*.ico   :splat  200
/*.woff  :splat  200
/*.woff2 :splat  200
/* /index.html  200
