# Cloudflare routing
# Order matters - most specific first

# Let all files with extensions pass through directly
# This prevents infinite loop because /cn/path/index.html has .html and stops here
# Use * capture in source and :splat in destination to preserve the full path
*.html  /:splat.html  200
*.css   /:splat.css   200
*.js    /:splat.js    200
*.png   /:splat.png   200
*.jpg   /:splat.jpg   200
*.jpeg  /:splat.jpeg  200
*.webp  /:splat.webp  200
*.svg   /:splat.svg   200
*.ico   /:splat.ico   200
*.txt   /:splat.txt   200
*.xml   /:splat.xml   200
*.json  /:splat.json  200

# Root paths without language prefix - let React Router handle redirect to /cn
/about    /index.html    200
/solutions/:splat    /index.html    200
/products    /index.html    200
/products/:splat    /index.html    200
/culture    /index.html    200
/quote    /index.html    200
/tour    /index.html    200
/blog    /index.html    200
/blog/:splat    /index.html    200
/privacy    /index.html    200
/terms    /index.html    200

# Language-prefixed deep paths - rewrite to /path/index.html
# The above extension rules prevent infinite loop because .html stops matching
/cn/*    /cn/:splat/index.html    200
/en/*    /en/:splat/index.html    200

# All other paths are automatically handled by Cloudflare Pages
