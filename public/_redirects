# Cloudflare Pages routing - SEO redirects only

# 301 redirects for root paths to /cn/ version
/about  /cn/about 301
/products  /cn/products 301
/culture  /cn/culture 301
/quote  /cn/quote 301
/tour  /cn/tour 301
/blog  /cn/blog 301
/privacy  /cn/privacy 301
/terms  /cn/terms 301
/solutions/:splat  /cn/solutions/:splat 301
/products/:splat  /cn/products/:splat 301
/blog/:splat  /cn/blog/:splat 301
/  /cn/ 301

# SPA routing handled by functions/_middleware.js
# This avoids infinite loop detection in _redirects